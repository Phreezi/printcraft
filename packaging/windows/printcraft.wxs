<?xml version="1.0" encoding="utf-8"?>
<!--
  PeDeeFe MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build printcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -d DocIconPath=... -o out.msi

  PeDeeFe is a fork of PrintCraft with its own identity (name, manufacturer, UpgradeCode, component
  GUIDs, executable name, ProgID and registry keys), so it installs next to an official PrintCraft
  instead of replacing it, and carries none of the ArtCraft marks or links.

  Per-machine install into Program Files, a Start Menu shortcut, an App Paths entry, and PeDeeFe
  registered as a PDF handler (offered under "Open with" and in Default apps, never forced as the
  default). Files opened with PeDeeFe arrive on its command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="PeDeeFe"
      Manufacturer="Phreezi"
      Version="$(var.Version)"
      UpgradeCode="5D0F6C2B-8E3A-4B71-9C4D-2A6E1F7B3C58"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="PeDeeFe PDF workbench (based on PrintCraft)" Manufacturer="Phreezi" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of PeDeeFe is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="PrintcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PrintcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Phreezi/printcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Phreezi/printcraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Phreezi/printcraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="PeDeeFe" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="PeDeeFe" Level="1">
      <ComponentGroupRef Id="PrintcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PrintcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PrintcraftApp" Guid="9B2E4A71-3C6D-4F08-8A5E-71D2C4B9E063">
        <File Id="PrintcraftExe" Source="$(var.BinDir)\printcraft.exe" Name="pedeefe.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="PeDeeFe"
              Description="PeDeeFe PDF workbench" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="PrintcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\pedeefe.exe" Value="[#PrintcraftExe]" Type="string" />

        <!-- PDF files (#107): PrintCraft is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             entry to pick was the advertised Start Menu shortcut, which Windows can't run as a
             file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\PeDeeFe.Document" Value="PDF Document" Type="string" />
        <!-- PDF files opened with PeDeeFe show its document icon (assets/brand/pedeefe/document). -->
        <File Id="PedeefeDocIcon" Source="$(var.DocIconPath)" Name="pedeefe-document.ico" />
        <RegistryValue Root="HKLM" Key="Software\Classes\PeDeeFe.Document\DefaultIcon" Value="[#PedeefeDocIcon]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\PeDeeFe.Document\shell\open\command" Value="&quot;[#PrintcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="PeDeeFe.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pedeefe.exe" Name="FriendlyAppName" Value="PeDeeFe" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pedeefe.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pedeefe.exe\shell\open\command" Value="&quot;[#PrintcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PeDeeFe\Capabilities" Name="ApplicationName" Value="PeDeeFe" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PeDeeFe\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench, based on PrintCraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PeDeeFe\Capabilities" Name="ApplicationIcon" Value="[#PrintcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PeDeeFe\Capabilities\FileAssociations" Name=".pdf" Value="PeDeeFe.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="PeDeeFe" Value="Software\PeDeeFe\Capabilities" Type="string" />
      </Component>

      <Component Id="PrintcraftCli">
        <File Id="PrintcraftCliExe" Source="$(var.BinDir)\printcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
